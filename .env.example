POF_APP_HOST=0.0.0.0
POF_APP_PORT=28280
POF_DASHBOARD_HOST=192.168.1.76
POF_DASHBOARD_URL=http://192.168.1.76:28280
POF_REQUEST_TIMEOUT_SECONDS=1.5

# Leave auth off while building locally. Turn on before exposing beyond trusted machines.
POF_AUTH_ENABLED=false
POF_MASTER_TOKEN=replace-with-your-private-master-token
POF_CODEX_TOKEN=replace-with-a-limited-codex-service-token

# Machine routes. Fill in the laptop IP once it is stable/reserved.
POF_DESKTOP_LAN=192.168.1.76
POF_DESKTOP_DIRECT=192.168.2.51
POF_NAS_LAN=192.168.1.177
POF_NAS_DIRECT=192.168.2.50
POF_LAPTOP_LAN=192.168.1.76
POF_LAPTOP_DIRECT=192.168.2.51
POF_ROUTE_ORDER=direct,lan

# Local-first storage defaults to ./data/pof2828.db.
POF_DATA_DIR=
POF_SQLITE_PATH=

# Optional NAS/PostgreSQL persistence. Do not commit real passwords.
POF_POSTGRES_DSN=
POF_POSTGRES_MAIN_DSN=
POF_POSTGRES_MEMORY_DSN=
POF_POSTGRES_ANALYTICS_DSN=

# Optional Synology DSM/File Station integration.
POF_SYNOLOGY_HOST=192.168.1.177
POF_SYNOLOGY_PORT=5000
POF_SYNOLOGY_USERNAME=
POF_SYNOLOGY_PASSWORD=
POF_SYNOLOGY_QUICKCONNECT_ID=
POF_SYNOLOGY_SECURE=false
POF_SYNOLOGY_CERT_VERIFY=false
POF_SYNOLOGY_DSM_VERSION=7
